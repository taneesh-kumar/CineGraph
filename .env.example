# CineGraph Environment Configuration
# Copy this file to .env and provide your secret passwords.
# NEVER commit .env to version control!

# ==============================================================================
# Neo4j Graph Database
# ==============================================================================
NEO4J_VERSION=5.26.0
NEO4J_USER=neo4j
# Set a strong password (minimum 8 characters)
NEO4J_PASSWORD=cinegraph_neo4j_secret_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://127.0.0.1:7687

# ==============================================================================
# MonetDB Columnar Analytical Database
# ==============================================================================
MONETDB_VERSION=latest
MONETDB_DATABASE=cinegraph
MONETDB_USER=monetdb
# Administrator password for MonetDB databases created upon startup
MONETDB_PASSWORD=cinegraph_monetdb_secret_change_me
# Passphrase for remote daemon management (merovingian dbfarm manager)
MONETDB_DAEMON_PASS=cinegraph_daemon_passphrase_change_me
MONETDB_HOST=127.0.0.1
MONETDB_PORT=50000

# ==============================================================================
# Ingestion Configuration
# ==============================================================================
DATASET_DIR=data/raw/ml-32m
INGESTION_BATCH_SIZE=5000
# Set > 0 for sample mode (e.g. 1000 movies), 0 for full import
INGESTION_SAMPLE_LIMIT=0

# ==============================================================================
# FastAPI Backend
# ==============================================================================
FASTAPI_ENV=development
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_DEBUG=True

# ==============================================================================
# Next.js Frontend
# ==============================================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PORT=3000
